{
    "name": "wilycode/router",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0 || ^1.1",
        "psr/http-message": "^2.0 || ^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Router\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "description": "PSR-7/PSR-15 router with named routes, typed rules, middleware and URL generation.",
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/phpunit.xml",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/CONTRIBUTING.md",
            "/CHANGELOG.md",
            "/composer.lock"
        ]
    },
    "suggest": {
        "wilycode/router-attribute": "Optional PHP attribute-based route declarations (separate integration package).",
        "wilycode/router-profiler": "Optional router and controller timing diagnostics (separate integration package)."
    },
    "keywords": [
        "router",
        "routing",
        "psr-7",
        "psr-15",
        "middleware",
        "url-generation",
        "php"
    ],
    "homepage": "https://github.com/wilycode/router",
    "support": {
        "issues": "https://github.com/wilycode/router/issues",
        "source": "https://github.com/wilycode/router"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
